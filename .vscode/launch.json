{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to UrlShortener (Docker volume)",
      "type": "coreclr",
      "request": "attach",
      "processId": "1",
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeArgs": ["exec", "-i", "urlshortenerapp"],
        "debuggerPath": "/remote_debugger/vsdbg",
        "pipeCwd": "${workspaceFolder}",
        "quoteArgs": false
      },
      "sourceFileMap": {
        "/app": "${workspaceFolder}/UrlShortener"
      },
      "justMyCode": false,
      "requireExactSource": false
    }
  ]
}
